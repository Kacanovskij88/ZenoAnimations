<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Integraties met distributiesystemen</title>
<link rel="stylesheet" href="_shared.css" />
<style>
  .grid {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    align-items: center;
    justify-items: center;
    padding: 30px 36px;
  }
  .col-bij { align-items: center; max-width: 460px; width: 100%; }
  .stack-cards { display: flex; flex-direction: column; gap: 12px; width: 100%; }
  .stack-card {
    background: var(--panel);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-md);
    padding: 14px 22px;
    text-align: center;
    width: 100%;
  }
  .stack-card .top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    justify-content: center;
  }
  .stack-card p { font-size: 14px; color: var(--ink-soft); margin: 4px 0 0; }
  .stack-card .ico-amber {
    width: 24px; height: 24px;
    display: inline-grid; place-items: center;
    background: var(--amber); border-radius: 7px;
    color: #1f2937;
  }
</style>
</head>
<body>
  <main class="stage" aria-label="Integraties met distributiesystemen">
    <div class="grid">

      <section class="col col-bij" aria-labelledby="lbl-bij">
        <span class="label" id="lbl-bij">Bijlagen</span>
        <div class="stack-cards" role="group">
          <button class="card stack-card" type="button">
            <div class="top">
              <span class="ico-amber" aria-hidden="true">
                <!-- folder -->
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              </span>
              Folders
            </div>
            <p>Promotiemateriaal automatisch meegeleverd</p>
          </button>
          <button class="card stack-card" type="button">
            <div class="top">
              <span class="ico-amber" aria-hidden="true">
                <!-- copies / stacked pages -->
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="3" width="13" height="16" rx="1.5"/><rect x="4" y="6" width="13" height="16" rx="1.5"/></svg>
              </span>
              Supplementen
            </div>
            <p>Editions en specials per uitgave gekoppeld</p>
          </button>
          <button class="card stack-card" type="button">
            <div class="top">
              <span class="ico-amber" aria-hidden="true">
                <!-- columns / district -->
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="5" height="16" rx="1"/><rect x="11" y="4" width="2" height="16"/><rect x="15" y="4" width="5" height="16" rx="1"/></svg>
              </span>
              Wijkgebonden bijlagen
            </div>
            <p>Gerichte verspreiding per gebied of doelgroep</p>
          </button>
          <button class="card stack-card" type="button">
            <div class="top">
              <span class="ico-amber" aria-hidden="true">
                <!-- stacked invoices -->
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="11" height="15" rx="1"/><rect x="3" y="6" width="11" height="15" rx="1"/><path d="M6 11h6M6 14h4"/></svg>
              </span>
              Facturen
            </div>
            <p>Facturatie gekoppeld aan distributie en levering</p>
          </button>
        </div>
      </section>

    </div>
  </main>
</body>
</html>
