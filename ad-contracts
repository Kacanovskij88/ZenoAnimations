<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Advertentiecontracten en orders</title>
<link rel="stylesheet" href="_shared.css" />
<style>
  .grid {
    grid-template-columns: 1fr 1.55fr;
    grid-template-rows: auto auto;
  }
  .col-types { grid-column: 1; grid-row: 1; }
  .col-flex { grid-column: 2; grid-row: 1; align-items: flex-end; }
  .bottom-row { grid-row: 2; }
</style>
</head>
<body>
  <main class="stage" aria-label="Advertentiecontracten en orders">
    <div class="grid">

      <!-- ADVERTENTIETYPES (blue group) -->
      <section class="col col-types" aria-labelledby="lbl-types">
        <span class="label" id="lbl-types">Advertentietypes</span>
        <div class="card bluecard" role="group">
          <div class="bluecard-list">
            <button class="brow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- monitor -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="1.5"/><path d="M9 21h6M12 17v4"/></svg>
              </span>
              Online
            </button>
            <button class="brow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- printer -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9V4h10v5"/><rect x="3" y="9" width="18" height="9" rx="2"/><rect x="7" y="14" width="10" height="6" rx="1.2"/></svg>
              </span>
              Print
            </button>
            <button class="brow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- newspaper -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M7 9h6M7 12h6M7 15h4"/><rect x="15" y="9" width="3" height="6" rx=".5"/></svg>
              </span>
              Nieuwsbrieven
            </button>
            <button class="brow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- ticket / event -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4z"/><path d="M10 6v12"/></svg>
              </span>
              Evenementen
            </button>
          </div>
        </div>
      </section>

      <!-- FLEX CONTRACTEN (white card) -->
      <section class="col col-flex" aria-labelledby="lbl-flex">
        <span class="label" id="lbl-flex" style="align-self:flex-end;">Flex. contracten</span>
        <div class="card whitecard" role="group" style="width:100%;">
          <div class="whitecard-list">
            <button class="wrow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- bar chart -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><rect x="6" y="13" width="3" height="7" rx=".5"/><rect x="11" y="9" width="3" height="11" rx=".5"/><rect x="16" y="5" width="3" height="15" rx=".5"/></svg>
              </span>
              <div>
                <h3>Volumebasis</h3>
                <p>Afspraken op basis van afnamevolume</p>
              </div>
            </button>
            <button class="wrow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- diamond -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M2 9h20"/><path d="M9 3l3 6 3-6"/><path d="M12 9l0 12"/></svg>
              </span>
              <div>
                <h3>Waardebasis</h3>
                <p>Contracten op basis van omzetwaarde</p>
              </div>
            </button>
            <button class="wrow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- circle -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2" fill="currentColor" stroke="none"/></svg>
              </span>
              <div>
                <h3>Eenmalig</h3>
                <p>Losse plaatsingen zonder contract</p>
              </div>
            </button>
          </div>
        </div>
      </section>

      <!-- PLAATSINGSINFO (3-up bottom row) -->
      <section class="col bottom-row" aria-labelledby="lbl-pl">
        <span class="label" id="lbl-pl">Plaatsingsinfo</span>
        <div class="three-row">
          <button class="card minicard" type="button">
            <div class="top">
              <span class="ico-amber" aria-hidden="true">
                <!-- book / page -->
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="1.5"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>
              </span>
              Pagina's
            </div>
            <div class="sub">Vaste posities binnen printpagina's</div>
          </button>
          <button class="card minicard" type="button">
            <div class="top">
              <span class="ico-amber" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><rect x="6" y="13" width="3" height="7" rx=".5"/><rect x="11" y="9" width="3" height="11" rx=".5"/><rect x="16" y="5" width="3" height="15" rx=".5"/></svg>
              </span>
              CPM
            </div>
            <div class="sub">Afrekening op basis van bereik en impressies</div>
          </button>
          <button class="card minicard" type="button">
            <div class="top">
              <span class="ico-amber" aria-hidden="true">
                <!-- 4-grid columns -->
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/></svg>
              </span>
              Kolommen
            </div>
            <div class="sub">Flexibele indeling binnen printlayouts</div>
          </button>
        </div>
      </section>

    </div>
  </main>
</body>
</html>
