<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Orders, facturering en omzetbeheer</title>
<link rel="stylesheet" href="_shared.css" />
<style>
  .grid {
    grid-template-columns: 1fr 1.4fr;
    grid-template-rows: auto auto;
    gap: 14px 24px;
    padding: 28px 36px;
  }
  .col-rap { grid-column: 1; grid-row: 1 / span 2; align-items: flex-start; align-self: center; }
  .col-pl  { grid-column: 2; grid-row: 1; align-items: flex-start; }
  .col-omz { grid-column: 2; grid-row: 2; align-items: center; align-self: end; }

  /* tighter blue rows for 4-line list */
  .col-rap .brow { padding: 12px 8px; min-width: 220px; }
  .col-rap .brow h3, .col-rap .brow .lbl { font-size: 16px; line-height: 1.2; }
  .col-rap .brow .lbl-2line { display: inline-block; }

  .pill-card {
    background: var(--panel);
    border-radius: var(--r-pill);
    padding: 10px 22px 10px 14px;
    box-shadow: var(--shadow-sm);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    width: fit-content;
  }
  .pill-card.is-active { background: var(--dark-tile); color: #fff; }
  .pill-card .ico-mini { width: 18px; height: 18px; display: grid; place-items: center; flex: none; }
  .pill-card.is-active .ico-mini { color: #fff; }

  .col-omz .pills-row { display: flex; gap: 12px; align-items: center; }
</style>
</head>
<body>
  <main class="stage" aria-label="Orders, facturering en omzetbeheer">
    <div class="grid">

      <!-- RAPPORTEN -->
      <section class="col col-rap" aria-labelledby="lbl-rap">
        <span class="label" id="lbl-rap">Rapporten</span>
        <div class="card bluecard" role="group">
          <div class="bluecard-list">
            <button class="brow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- triangle alert -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 3 20h18z"/><path d="M12 10v5"/><circle cx="12" cy="17.5" r=".8" fill="currentColor"/></svg>
              </span>
              Misserslijst
            </button>
            <button class="brow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- trophy -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10v4a5 5 0 0 1-10 0z"/><path d="M5 5H3v3a3 3 0 0 0 4 3"/><path d="M19 5h2v3a3 3 0 0 1-4 3"/><path d="M9 14h6l-1 4h-4z"/><path d="M8 20h8"/></svg>
              </span>
              <span class="lbl-2line">Gewonnen<br/>opportunities</span>
            </button>
            <button class="brow" type="button">
              <span class="ico" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              </span>
              Tijdvergelijking
            </button>
            <button class="brow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- bar chart up -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V9"/><path d="M10 19v-7"/><path d="M16 19v-4"/><path d="M3 6l5 4 4-3 6 5"/></svg>
              </span>
              Performance
            </button>
          </div>
        </div>
      </section>

      <!-- PLAATSINGSACCORDERING -->
      <section class="col col-pl" aria-labelledby="lbl-pl">
        <span class="label" id="lbl-pl" style="align-self:center;">Plaatsingsaccordering</span>
        <div class="card whitecard" role="group" style="width:100%;">
          <div class="whitecard-list">
            <button class="wrow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- finger tap -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11V5a2 2 0 0 1 4 0v6"/><path d="M13 9a2 2 0 0 1 4 0v3"/><path d="M17 11a2 2 0 0 1 3 1.5V17a4 4 0 0 1-4 4h-3l-4-4-3-2a1.5 1.5 0 0 1 1.5-2.5L13 14"/></svg>
              </span>
              <div>
                <h3>Handmatig</h3>
                <p>Handmatige controle en goedkeuring per factuur</p>
              </div>
            </button>
            <button class="wrow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- boxes -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="8" height="8" rx="1"/><rect x="13" y="11" width="8" height="8" rx="1"/><rect x="8" y="3" width="8" height="8" rx="1"/></svg>
              </span>
              <div>
                <h3>Bulk</h3>
                <p>Meerdere facturen in één keer accorderen</p>
              </div>
            </button>
            <button class="wrow" type="button">
              <span class="ico" aria-hidden="true">
                <!-- gear / arrows -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 13.5-5.7L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.5 5.7L4 16"/><path d="M4 20v-4h4"/></svg>
              </span>
              <div>
                <h3>Automatisch</h3>
                <p>Facturen automatisch goedgekeurd op basis van regels</p>
              </div>
            </button>
          </div>
        </div>
      </section>

      <!-- OMZETBEHEER -->
      <section class="col col-omz" aria-labelledby="lbl-omz">
        <span class="label" id="lbl-omz">Omzetbeheer</span>
        <div class="pills-row">
          <button class="card pill-card" type="button">
            <span class="ico-mini" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 11h18"/></svg>
            </span>
            Historisch
          </button>
          <button class="card pill-card is-active" type="button">
            <span class="ico-mini" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h8l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5"/><path d="M9 13h7M9 17h5"/></svg>
            </span>
            Te factureren
          </button>
          <button class="card pill-card" type="button">
            <span class="ico-mini" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 1 8 8"/><path d="M4 12V8M4 12h4"/></svg>
            </span>
            Verwacht
          </button>
        </div>
      </section>

    </div>
  </main>
</body>
</html>
